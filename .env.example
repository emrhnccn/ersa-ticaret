# Eski Mongo bağlantısı artık ticaret kaynağı değildir. Kaldırılabilir.
# MONGODB_URI=""

# Auth (Faz 2)
AUTH_SECRET="replace-with-random-32-chars-min"

# Ödeme sağlayıcı (Faz 6) — frontend'e koymayın
